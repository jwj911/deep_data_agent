# External service credentials. Replace placeholders only in the local .env file.
MOONSHOT_API_KEY=your_moonshot_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# Model configuration
MODEL_NAME=kimi-k2-turbo-preview
MODEL_BASE_URL=https://api.moonshot.cn/v1
MODEL_TEMPERATURE=0.3
MODEL_REQUEST_TIMEOUT_SECONDS=45
MODEL_MAX_RETRIES=1
MODEL_MAX_OUTPUT_TOKENS=4096

# Agent run budgets
AGENT_QUERY_MAX_CHARS=8000
AGENT_RESPONSE_MAX_CHARS=32000
AGENT_RUN_TIMEOUT_SECONDS=60
AGENT_RECURSION_LIMIT=25
AGENT_MODEL_CALL_LIMIT=8
AGENT_TOOL_CALL_LIMIT=12
AGENT_GLOBAL_CONCURRENCY_LIMIT=4
AGENT_USER_CONCURRENCY_LIMIT=1
AGENT_CONCURRENCY_WAIT_SECONDS=1
AGENT_CONCURRENCY_LEASE_TTL_SECONDS=75

# Internet search budgets
SEARCH_QUERY_MAX_CHARS=2000
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT_SECONDS=15
SEARCH_MAX_OUTPUT_BYTES=65536

# FastAPI listener configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
NEXT_PUBLIC_REST_API_URL=http://localhost:8000

# First-party authentication configuration
# Replace this local-only placeholder with at least 32 random characters.
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Host-local persistence and cache configuration
DATABASE_URL=mysql+pymysql://root:test@localhost:3306/mydb
REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_TIMEOUT_SECONDS=1.0
REDIS_RECOVERY_INITIAL_BACKOFF_SECONDS=1
REDIS_RECOVERY_MAX_BACKOFF_SECONDS=30
REDIS_RECOVERY_JITTER_RATIO=0.2

# Owner-scoped managed text files. Values are bytes unless noted otherwise.
FILE_STORAGE_ROOT=var/managed_files
FILE_UPLOAD_MAX_BYTES=5242880
FILE_UPLOAD_BATCH_MAX_BYTES=10485760
FILE_UPLOAD_REQUEST_MAX_BYTES=11534336
FILE_UPLOAD_BATCH_MAX_COUNT=5
FILE_USER_QUOTA_BYTES=104857600
FILE_USER_MAX_COUNT=100
FILE_RETENTION_HOURS=168
FILE_ANALYSIS_MAX_CHARS=20000

# Browser-facing LangGraph configuration.
# NEXT_PUBLIC_API_URL is embedded at frontend build time and MUST be reachable
# by the user's browser. Do not use a Docker-only hostname such as backend01.
NEXT_PUBLIC_API_URL=http://localhost:2024
NEXT_PUBLIC_ASSISTANT_ID=agent

# Docker Compose host ports and local database bootstrap values
MYSQL_ROOT_PASSWORD=test
MYSQL_DATABASE=mydb
COMPOSE_DATABASE_URL=mysql+pymysql://root:test@mysql:3306/mydb
COMPOSE_REDIS_URL=redis://redis:6379/0
COMPOSE_FILE_STORAGE_ROOT=/data/managed-files
MYSQL_PORT=3306
REDIS_PORT=6379
LANGGRAPH_PORT=2024
FRONTEND_PORT=3000

# Logging
SERVICE_NAME=deep-data-agent
LOG_LEVEL=INFO
LOG_FILE_PATH=deep_data_agent.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=3
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=3

# 请求限流（按身份维度的固定窗口限流）。
# RATE_LIMIT_ENABLED=false 可整体关闭限流。
# TRUSTED_PROXY_COUNT 默认 0 表示不信任 X-Forwarded-For，来源以直接连接地址为准。
RATE_LIMIT_ENABLED=true
TRUSTED_PROXY_COUNT=0
RATE_LIMIT_AUTH_MAX_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_QUERY_MAX_REQUESTS=20
RATE_LIMIT_QUERY_WINDOW_SECONDS=60
RATE_LIMIT_SESSION_MAX_REQUESTS=60
RATE_LIMIT_SESSION_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT_MAX_REQUESTS=120
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60
